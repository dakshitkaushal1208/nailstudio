# Copy these into your shell (see README) or your IDE run configuration.
# Do NOT commit real values.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cute_icles_app
DB_USERNAME=cuteicles
DB_PASSWORD=change-me

# --- Auth ---
# At least 32 random characters. Required in production.
# In dev, if empty, a random one is generated at startup (logins reset on restart).
JWT_SECRET=
# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false

# --- Frontend ---
# Comma-separated list of allowed browser origins (exact scheme + host, no trailing slash).
# REQUIRED in production, e.g. https://your-site.vercel.app
FRONTEND_ORIGINS=http://localhost:5173
# The main frontend address, used for the link inside password-reset emails.
FRONTEND_ORIGIN_PRIMARY=http://localhost:5173

# --- Files ---
UPLOAD_DIR=./uploads

# --- First administrator (created at startup if no user has this email) ---
# Choose your own email and a long unique password (12+ chars, upper/lower/digit/symbol).
# Do NOT reuse an example value: this file is public on GitHub.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Mehak Dhiman

# --- Profile: dev (default) or prod ---
SPRING_PROFILES_ACTIVE=dev

# --- Email (optional; without it, emails are NOT sent) ---
EMAIL_ENABLED=false
EMAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- Production only (set in the hosting dashboard, never in Git) ---
# SPRING_PROFILES_ACTIVE=prod
# COOKIE_SECURE=true
# Only if the frontend and backend are on DIFFERENT sites (e.g. vercel.app + onrender.com):
# APP_JWT_COOKIE_SAME_SITE=None
# SERVER_FORWARD_HEADERS_STRATEGY=native   (already set in the Dockerfile)
