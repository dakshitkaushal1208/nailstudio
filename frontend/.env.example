# Copy to .env.local for local work. Never commit real credentials.
# On Vercel/Netlify set these as Environment Variables in the project settings instead.

# Backend API address, ending in /api (use your deployed HTTPS backend URL in production).
VITE_API_BASE_URL=http://localhost:8080/api

# true  = built-in demo data in the browser (nothing is saved to a real database; demo logins are NOT secure)
# false = use the Spring Boot API at VITE_API_BASE_URL   <-- REQUIRED for a real deployment
VITE_USE_MOCK=true
